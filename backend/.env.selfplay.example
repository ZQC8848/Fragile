# Self-play needs only these keys (selfplay.md §7.1). Copy to backend/.env, or add the lines to the .env you
# already have. Every model setting comes from backend/selfplay/profiles.yaml; this file holds no other config.
# backend/.env is gitignored: never commit a key.

# DeepSeek: the engine roles and two of the player models
DEEPSEEK_API_KEY=
# Moonshot: the kimi-k2.6 player (test split) and the judge
MOONSHOT_API_KEY=
# The third player provider, once it is chosen (selfplay.md S1); then add its profile in profiles.yaml
# QWEN_API_KEY=

# Claude and GPT players need no key: they run on your own subscription through the `claude` and `codex`
# command lines. Log in to both once; `uv run python -m selfplay doctor --probe` checks that they answer.
