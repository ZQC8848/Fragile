# Copy to backend/.env and fill in. backend/.env is gitignored and is the ONLY place keys live;
# never put a key in this file or anywhere else that is committed.
#
# Roles (plan.md section 3.3): REVIEW NARRATOR GUARD TENSION SCORER PROPOSER OPTIONS SELFPLAY JUDGE
# Provider values: openai | anthropic | mock   (mock = deterministic canned output, no network)
# `openai` also covers OpenAI-compatible endpoints (DeepSeek, Kimi, ...): set LLM_BASE_URL_<ROLE>.
# Every role defaults to mock.

# A role with a non-mock provider still answers from its mock until it is listed here (comma list),
# or switched live from the Console. Example: LLM_LIVE_ROLES=review,narrator,guard
LLM_LIVE_ROLES=

# M2: segment / translate / validate / rewrite / classify player input
LLM_PROVIDER_REVIEW=mock
LLM_MODEL_REVIEW=
LLM_BASE_URL_REVIEW=
LLM_API_KEY_REVIEW=

# first-person narration
LLM_PROVIDER_NARRATOR=mock
LLM_MODEL_NARRATOR=
LLM_BASE_URL_NARRATOR=
LLM_API_KEY_NARRATOR=

# M3: consistency guard
LLM_PROVIDER_GUARD=mock
LLM_MODEL_GUARD=
LLM_BASE_URL_GUARD=
LLM_API_KEY_GUARD=

# M4: tension estimate
LLM_PROVIDER_TENSION=mock
LLM_MODEL_TENSION=
LLM_BASE_URL_TENSION=
LLM_API_KEY_TENSION=

# M1: scorer B
LLM_PROVIDER_SCORER=mock
LLM_MODEL_SCORER=
LLM_BASE_URL_SCORER=
LLM_API_KEY_SCORER=

# GENERATE_NEW beat proposer
LLM_PROVIDER_PROPOSER=mock
LLM_MODEL_PROPOSER=
LLM_BASE_URL_PROPOSER=
LLM_API_KEY_PROPOSER=

# player option generation
LLM_PROVIDER_OPTIONS=mock
LLM_MODEL_OPTIONS=
LLM_BASE_URL_OPTIONS=
LLM_API_KEY_OPTIONS=

# self-play persona players
LLM_PROVIDER_SELFPLAY=mock
LLM_MODEL_SELFPLAY=
LLM_BASE_URL_SELFPLAY=
LLM_API_KEY_SELFPLAY=

# offline judge / pre-annotation: a different vendor from every role above
LLM_PROVIDER_JUDGE=mock
LLM_MODEL_JUDGE=
LLM_BASE_URL_JUDGE=
LLM_API_KEY_JUDGE=

# Fallbacks used when a role has no LLM_API_KEY_<ROLE> / LLM_BASE_URL_<ROLE> of its own
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# Response cache in backend/data/cache/ (gitignored). 1 = on. Default off (live play samples fresh);
# self-play turns it on. The mock provider never uses it.
LLM_CACHE=0

# Prompt files are backend/prompts/<role>_v<N>.md and the highest N is used. Pin a version per role:
# PROMPT_VERSION_REVIEW=1
# PROMPT_VERSION_NARRATOR=2
# PROMPT_VERSION_GUARD=1

# Request timeout in seconds per role (default 60; narrator 90; proposer and judge 120). A timed-out call is
# retried once, then the role falls back (plan.md section 3.2).
# LLM_TIMEOUT_NARRATOR=90
