{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fragile.dev/schemas/llm/scorer.json",
  "title": "LLM output: scorer B (M1 llm path)",
  "description": "Integer offset per candidate beat (WrongestPerson scorer B).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offsets"
  ],
  "properties": {
    "offsets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "offset"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": -5,
            "maximum": 5
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
